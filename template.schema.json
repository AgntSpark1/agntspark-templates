{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AgntSpark1/agntspark-templates/template.schema.json",
  "title": "AgntSpark Agent Template",
  "description": "agent.yaml for a template run by agntspark/agent-runtime (runtime contract v1), which loads it from AGNTSPARK_TEMPLATE_DIR.",
  "type": "object",
  "required": ["name", "version", "description", "llm", "system_prompt"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "Template id; must match the template's directory name",
      "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$",
      "minLength": 3,
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "description": "Semantic version",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "author": {
      "type": "string"
    },
    "license": {
      "type": "string",
      "description": "SPDX identifier",
      "default": "MIT"
    },
    "tags": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "llm": {
      "type": "object",
      "description": "Default model. Platform environment (LLM_MODEL / LLM_PROVIDER) overrides it at deploy time.",
      "required": ["model"],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["openai", "anthropic", "google"],
          "description": "Inferred from the model name when omitted"
        },
        "model": {
          "type": "string"
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 0.7
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000,
          "default": 4096
        }
      }
    },
    "system_prompt": {
      "type": "string",
      "description": "Used unless the agent is deployed with its own non-empty system prompt. Tool descriptions and the tool-call format are appended by the runtime.",
      "minLength": 10
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "handler"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": {
            "type": "string"
          },
          "handler": {
            "type": "string",
            "description": "module:function — a function in <module>.py next to agent.yaml, called with keyword arguments",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*:[A-Za-z_][A-Za-z0-9_]*$"
          },
          "parameters": {
            "type": "object",
            "description": "Argument name → description, shown to the model",
            "additionalProperties": {"type": "string"}
          }
        }
      }
    },
    "env": {
      "type": "array",
      "description": "Environment variables the template reads, set by the deployer (DeployConfig.env). The LLM key is not listed here; it comes from the agent's api_key.",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "description": {
            "type": "string"
          },
          "required": {
            "type": "boolean",
            "default": false
          },
          "secret": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "category": {"type": "string"},
        "icon": {"type": "string", "description": "Emoji or image URL"},
        "examples": {
          "type": "array",
          "description": "Example first messages",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    }
  }
}
